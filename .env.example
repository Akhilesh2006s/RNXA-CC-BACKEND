NODE_ENV=production
PORT=5000
MONGO_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# CORS: comma-separated, exact origins (scheme + host, no trailing slash).
# Include your deployed frontend plus localhost only if you still develop against this API:
# CLIENT_ORIGIN=https://founder-os-frontend-XXXX.vercel.app,http://localhost:3000

CLIENT_ORIGIN=http://localhost:3000

# Production deploy: NODE_ENV=production recommended.
#
# Cookies for Vercel→Railway: SameSite=None+Secure applies when CLIENT_ORIGIN has an https URL
# (not localhost). Override with COOKIE_SAMESITE_NONE=true if needed.
