NODE_ENV=production
PORT=5000

# MongoDB Atlas — use "Standard connection string" (mongodb:// shard hosts), not mongodb+srv, if SRV DNS fails.
MONGO_URI=

# Generate strong secrets for production (32+ chars each):
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Comma-separated browser origins (no trailing slash):
# CLIENT_ORIGIN=https://your-app.vercel.app,http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# Optional Vercel preview suffix:
# CLIENT_ORIGIN_SUFFIXES=akhilesh2006s-projects.vercel.app

# Optional Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Local seed only (do not set on Railway unless running seed once):
# SEED_EMAIL=
# SEED_PASSWORD=
